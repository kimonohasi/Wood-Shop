# ============================================================================
# WoodCon — MẪU biến môi trường
#
#   Cách dùng:  copy file này thành `.env` (cùng thư mục gốc) rồi điền giá trị.
#     PowerShell:  Copy-Item .env.example .env
#
#   - `.env` bị .gitignore → KHÔNG BAO GIỜ commit. File này (.env.example)
#     chỉ chứa chỗ giữ chỗ, an toàn để đưa lên git.
#   - Biến môi trường THẬT của server (Apache vhost, Docker, `setx`...) luôn
#     được ưu tiên hơn giá trị trong `.env`.
#   - Chạy được ngay cả khi CHƯA có `.env`: DB dùng mặc định XAMPP
#     (root / không mật khẩu / woodcon_shop), secret để trống = tính năng tắt.
# ============================================================================

# ----- Ứng dụng -----
# APP_DEBUG=1 khi developing (hiện chi tiết lỗi); để 0 khi đưa lên production.
APP_DEBUG=0

# ----- Database (khớp tên DB đã import database/schema.sql) -----
DB_HOST=127.0.0.1
DB_NAME=woodcon_shop
DB_USER=root
DB_PASS=

# ----- Google OAuth — đăng nhập bằng Google -----
# Để TRỐNG = tắt chức năng đăng nhập Google.
# Tạo OAuth Client (Web) tại Google Cloud Console rồi dán vào đây;
# Redirect URI phải trùng GOOGLE_REDIRECT_URI (mặc định: <BASE_URL>/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Google reCAPTCHA v2 — xác thực form đăng nhập/đăng ký/quên mật khẩu -----
# Để TRỐNG = bỏ qua captcha (CHỈ chấp nhận ở môi trường local/dev).
# BẮT BUỘC cấu hình khi đưa site lên production.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ----- Tuỳ chọn ghi đè -----
# Chỉ cần đặt khi Apache tự dò BASE_URL sai (ví dụ DocumentRoot lệch hẳn
# khỏi thư mục dự án). Để trống = tự dò theo DOCUMENT_ROOT như mặc định.
# BASE_URL=https://domain-cua-ban.vn

# ----- Database cho script backup (PowerShell) -----
# Script backup ƯU TIÊN biến này trước, sau đó mới đọc DB_* ở trên.
# Thường để trống (đã có DB_*), chỉ dùng khi muốn backup sang DB khác.
# WOODSHOP_DB_PASS=
